@inject AuroraeDb db
@{
    ViewData["Title"] = "Aurorae";
}

@if (ViewBag.Cover)
{
    <style>
        body::before {
            content: '';
            position: absolute;
            height: 100vh;
            width: 100vw;
            left: 0;
            top: 0;
            background-image: url('/resources/images/@Aurorae.Controllers.GalleryController.RandomItems(db, 1).First().ItemPathEncoded');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        body {
            padding-top: 100vh;
        }
    </style>
}

<h1 class="display-4">@ViewData["Title"]</h1>

<div class="d-flex gap-2 mb-2" id="thumbnails">
    @await Html.PartialAsync("_CardList", Aurorae.Controllers.GalleryController.RandomItems(db, (int)ViewBag.Images).Select(x => ("_ThumbnailCard", (object)x)))
    <button type="button" onclick="loadMore(this)" class="btn btn-outline-primary flex-grow-1 align-content-center justify-content-center flex-wrap text-decoration-none">更多</button>
</div>

@section Scripts {
    <script>
        function loadMore(btn) {
            fetch(`/gallery/random/card`)
                .then(r => r.text())
                .then(html => {
                    btn.insertAdjacentHTML('beforebegin', html);
                });
        }
    </script>
}