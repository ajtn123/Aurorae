@using Aurorae.Models.DbModels
@model List<Note>
@{
    ViewData["Title"] = "笔记";
}

<h1>@ViewData["Title"]</h1>

<div class="btn-toolbar mb-2 gap-2 flex-wrap">
    <form method="get">
        <div class="input-group">
            <input type="search" class="form-control" name="filter" value="@Context.Request.Query["filter"]" placeholder="检索" />
            <button type="submit" class="btn btn-outline-success"><i class="bi bi-search"></i></button>
        </div>
    </form>
    <a class="btn btn-outline-primary" href="/notes/new">
        <i class="bi bi-plus-lg"></i> 新建笔记
    </a>
</div>

@if (Model.Count != 0)
{
    <div class="card mb-2">
        <div class="card-header border-0" role="button" data-bs-toggle="collapse" href="#note-list">
            笔记 @Model.Count
        </div>
        <div class="list-group list-group-flush border-top collapse show" id="note-list">
            @foreach (var note in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <a class="text-decoration-none flex-grow-1" href="/notes/@note.Id">
                            <h5 class="mb-1">@note.Title</h5>
                            <small class="text-muted">@note.UpdatedAt.ToLocalString()</small>
                        </a>
                        <div class="d-flex gap-1 ms-2">
                            <a class="btn btn-sm btn-outline-secondary" href="/notes/@note.Id/edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="/notes/@note.Id/delete" onsubmit="return confirm('确认删除笔记「@note.Title」？')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
