<!DOCTYPE html>
<html lang="zh-cn">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aurorae</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aurorae.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border rounded shadow-sm fixed-top m-2 px-3">
            <a class="navbar-brand" href="/">Aurorae</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <i class="navbar-toggler-icon"></i>
            </button>
            <ul class="navbar-nav navbar-collapse collapse align-items-start">
                <li class="nav-item">
                    <a class="nav-link" href="/gallery">图库</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/gallery/favorites">收藏</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/doc">文档</a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="text-muted lh-lg border-top">
        <div class="container">
            Aurorae
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>